// src/directives/appear.js
export default {
  mounted(el) {
    el.classList.add('appear-before')
    const items = el.querySelectorAll('.appear-item')
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.intersectionRatio === 0) {
          el.classList.remove('appear-visible')
          el.classList.add('appear-before')
        } else if (entry.isIntersecting && entry.intersectionRatio > 0.15) {
          const blockRect = el.getBoundingClientRect()
          const blockCenter = blockRect.left + blockRect.width / 2
          items.forEach((it) => {
            const r = it.getBoundingClientRect()
            const itemCenter = r.left + r.width / 2
            const sign = itemCenter < blockCenter ? -1 : 1
            const offset = 20 + Math.random() * 40
            const delay = Math.floor(Math.random() * 120)
            const dur = 180 + Math.floor(Math.random() * 70)
            it.style.setProperty('--appear-x', `${sign * offset}px`)
            it.style.setProperty('--appear-delay', `${delay}ms`)
            it.style.setProperty('--appear-duration', `${dur}ms`)
          })
          el.classList.add('appear-visible')
          el.classList.remove('appear-before')
        }
      })
    }, { threshold: [0, 0.2] })
    io.observe(el)
    el._appearObserver = io
  },
  unmounted(el) {
    const io = el._appearObserver
    if (io) {
      io.unobserve(el)
      io.disconnect()
      delete el._appearObserver
    }
  }
}